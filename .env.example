# Cấu hình Database MySQL 
DATABASE_URL=mysql+pymysql://username:password@localhost:3306/food_recomentdation

# Cấu hình Gửi Email Thực Tế qua Gmail SMTP
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_digit_app_password
MAIL_FROM=your_email@gmail.com
MAIL_FROM_NAME="Smart Dining"

# Cấu hình Tích hợp Dịch vụ LLM / NLP (Task TE9C668)
# Hỗ trợ Gemini API hoặc OpenAI API; nếu để trống hệ thống sẽ tự động dùng Rule-based NLP Tiếng Việt
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_PROVIDER=auto

