# ==============================================================================
# CẤU HÌNH MÔI TRƯỜNG HỆ THỐNG SMART DINING
# Copy file này thành ".env" trước khi chạy.
# ==============================================================================

# 1. Cơ sở dữ liệu (Mặc định SQLite chạy ngay; bỏ # dòng dưới nếu dùng MySQL XAMPP)
DATABASE_URL=sqlite:///./food_recommendation.db
# DATABASE_URL=mysql+pymysql://root:@localhost:3306/food_recommendation

# 2. Khóa bí mật JWT
SECRET_KEY=smart_dining_super_secret_key_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 3. API Key cho LLM (để trống hệ thống sẽ tự dùng Rule-based NLP Fallback)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# 4. Cấu hình gửi Email OTP (Gmail SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_digit_app_password
MAIL_FROM=your_email@gmail.com
MAIL_FROM_NAME="Smart Dining"